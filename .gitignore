# Local runtimes and Python/build caches
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
/build/
/dist/

# Access-controlled source/prepared data (manifests remain reviewable)
/data/raw/
/data/processed/
/data/cache/
/data/resources/
/data/tools/
/dataset/

# Runtime outputs, checkpoints, caches, and downloaded weights
/runs/
/artifacts/
/checkpoints/
/models/
/logs/
/wandb/
/.cache/
/hf_cache/
/torch_cache/
# Downloaded tokenizer resources stay local; revisions/hashes remain in configs.
/reports/method/backbones/*/tokenizer/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin
*.h5
*.hdf5
*.jar

# Secrets and authentication artifacts
# Kaggle API tokens for the team accounts (kaggle/<n>_account_<user>/kaggle.json); the folder holds nothing else
kaggle.json
/kaggle/
.env
.env.*
*.pem
*.key
*credentials*.json
*service_account*.json
*service-account*.json
token.json
tokens.json
secrets.json
/credentials/
/secrets/
/drive/
/.config/
.git-credentials
.netrc

# Papers/proposals stay outside the repo (copyright unclear; originals live in the parent folder)
*.pdf

# Machine-specific notebooks/editors/temp output
.ipynb_checkpoints/
.vscode/
.idea/
Thumbs.db
.DS_Store
/tmp/
